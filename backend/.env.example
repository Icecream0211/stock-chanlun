# DeepSeek API（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型 ID，诊股与策略 LLM 默认使用 V4 Pro
# DEEPSEEK_MODEL_ID=deepseek-v4-pro

# Gemini API（https://ai.google.dev）
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 OpenAI 兼容网关（可选，one-api/new-api 等）
# 设置 base URL 后即启用 custom 模型；模型名可含特殊字符（如 deepseek-v4-flash#claude）
# CUSTOM_LLM_BASE_URL=https://your-gateway.example.com/v1
# CUSTOM_LLM_API_KEY=sk-your-gateway-key
# CUSTOM_LLM_MODEL_ID=deepseek-v4-flash#claude

# 逗号分隔的前端源；默认 *（此时浏览器 Cookie 凭证跨域关闭）
# CORS_ORIGINS=http://localhost:5173,https://yourname.github.io

# 仅在东方财富等接口 SSL/代理异常时设为 1（默认校验证书）
# FINANCE_TLS_RELAXED=0

# 后端监听端口（run_server.py 与 python main.py 均读取，默认 8010）
# PORT=8010

# 选股缠论并发线程数（默认 12）
# SCREENING_WORKERS=12

# A 股行情源优先级：ifind 不可用或取数失败时自动回退 legacy（腾讯日线/新浪分钟线）
# MARKET_DATA_SOURCES=ifind,legacy

# 同花顺 iFinD（可选），任选一种鉴权方式：
# 1. 跨平台/服务器推荐 refresh token（从超级命令的账号详情获取）
# IFIND_REFRESH_TOKEN=your-ifind-refresh-token
# 2. 已有短期 access token（官方有效期通常为 7 天）
# IFIND_ACCESS_TOKEN=your-ifind-access-token
# 3. 本机 SDK：先执行 pip install iFinDAPI，再填写数据接口账号密码
# IFIND_ENABLED=1
# IFIND_USERNAME=your-ifind-interface-account
# IFIND_PASSWORD=your-ifind-interface-password

# 仅在可信反向代理（Railway/nginx 等会覆盖 X-Forwarded-For）之后设为 1，
# 否则客户端可伪造该头绕过每 IP 限流。默认 0（信任直连 socket IP）。
# TRUST_X_FORWARDED_FOR=0
